pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                git branch: 'main',
                    url: 'https://github.com/Eustusmurea/alx-backend-python.git',
                    credentialsId: '077f0262-c5f7-48ed-bb85-05d198594a77'
            }
        }

        stage('Install Dependencies') {
            steps {
                sh 'python3 -m venv venv'
                sh '. venv/bin/activate && pip install --upgrade pip'
                sh '. venv/bin/activate && pip install -r messaging_app/requirements.txt'
            }
        }

        stage('Run Tests') {
            steps {
                sh '. venv/bin/activate && pytest messaging_app/tests'
            }
        }

        stage('Lint') {
            steps {
                sh '. venv/bin/activate && flake8 messaging_app'
            }
        }

        stage('Build Docker Image') {
            steps {
                sh 'docker build -t messaging_app:latest -f messaging_app/Dockerfile .'
            }
        }
    }

    post {
        success {
            echo 'Pipeline executed successfully ✅'
        }
        failure {
            echo 'Pipeline failed ❌'
        }
    }
}
