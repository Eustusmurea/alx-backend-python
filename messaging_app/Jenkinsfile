pipeline {
    agent {
        docker {
            image 'python:3.12-slim'
            args '-u root:root'  // allows installing system deps if needed
        }
    }

    stages {
        stage('Checkout') {
            steps {
                git branch: 'main', 
                    url: 'https://github.com/Eustusmurea/alx-backend-python.git',
                    credentialsId: '077f0262-c5f7-48ed-bb85-05d198594a77'
            }
        }

        stage('Install Dependencies') {
            steps {
                dir('messaging_app') {
                    sh '''
                    apt-get update && apt-get install -y \
                    gcc \
                    pkg-config \
                    default-libmysqlclient-dev \
                    python3-dev \
                    build-essential

                    python -m venv venv
                    . venv/bin/activate
                    pip install --upgrade pip
                    pip install -r requirements.txt
                    pip install flake8 pytest
                    '''
                }
            }
        }
 


        // stage('Run Tests') {
        //     steps {
        //         sh '''
        //           . venv/bin/activate
        //           pytest --maxfail=1 --disable-warnings -q
        //         '''
        //     }
        // }

        stage('Lint') {
            steps {
                dir('messaging_app') {
                    sh '''
                      . venv/bin/activate
                      flake8 . --count --select=E9,F63,F7,F82 --show-source --statistics
                      flake8 . --count --exit-zero --max-complexity=10 --max-line-length=88 --statistics
                    '''
                }
            }
        }

        stage('Build Docker Image') {
            steps {
                sh 'docker build -t messaging_app:latest .'
            }
        }
    }

    post {
        success {
            echo 'Pipeline succeeded ✅'
        }
        failure {
            echo 'Pipeline failed ❌'
        }
    }
}
